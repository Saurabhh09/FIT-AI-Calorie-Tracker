# Copy to .env.local. Never commit secrets.
# Optional canonical public origin (e.g. https://fitai.example). Leave blank in previews.
FITAI_APP_ORIGIN=

# Supabase project URL and public anon/publishable key; both may be browser-visible.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# USDA FoodData Central Data.gov key. Server-only; do not add NEXT_PUBLIC_ prefix.
USDA_FDC_API_KEY=

# Optional server-side AI provider. Not implemented/configured in this migration slice.
FITAI_AI_PROVIDER=
FITAI_AI_API_KEY=
